# --- Secrets: NEVER commit these ---
.env
.env.*
!.env.example
!deploy/.env.production.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / frontend ---
node_modules/
dist/
*.tsbuildinfo

# --- Local evidence files (uploaded during development) ---
# Evidence files live in /storage at the repository root. The leading slash matters:
# without it, backend/app/storage (code!) was ignored too and never reached GitHub.
/storage/

# --- Browser-automation scratch files ---
.playwright-mcp/

# --- Logs & OS noise ---
*.log
.DS_Store
Thumbs.db

# Playwright end-to-end test output
frontend/test-results/
frontend/playwright-report/
frontend/e2e/.auth/

# Production settings (secrets). Only the .example file is committed.
deploy/.env.production

# Backups made by deploy/backup.sh
backups/

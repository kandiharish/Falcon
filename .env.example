# Copy this file to .env and fill in real values.
# .env is ignored by Git — never commit real secrets.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_DB=falcon
POSTGRES_USER=falcon
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Where the backend finds the database, as seen from your computer.
# Change the port if it is already used on your machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# --- Development only: password for the fictional demo users ---
# Create them with: cd backend && uv run python -m app.scripts.seed_demo_users
DEMO_PASSWORD=change-me-demo-password

# Copy this file to .env and fill in real values.
# .env is ignored by Git — never commit real secrets.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_DB=falcon
POSTGRES_USER=falcon
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Where the backend finds the database, as seen from your computer.
# Change the port if it is already used on your machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# --- Development only: password for the fictional demo users ---
# Create them with: cd backend && uv run python -m app.scripts.seed_demo_users
DEMO_PASSWORD=change-me-demo-password

# Local AI (optional): Ollama on this computer. Set AI_ENABLED=false to switch AI features off.
# AI_ENABLED=true
# OLLAMA_URL=http://127.0.0.1:11434
# AI_CHAT_MODEL=qwen3:8b
# AI_EMBED_MODEL=all-minilm

# Encrypts MFA secrets at rest (required for multi-factor authentication).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
FALCON_SECRET_KEY=

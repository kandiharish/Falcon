# Copy this file to .env and fill in real values.
# .env is ignored by Git — never commit real secrets.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_DB=falcon
POSTGRES_USER=falcon
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Host port; change if 5432 is already used on your machine
POSTGRES_PORT=5434

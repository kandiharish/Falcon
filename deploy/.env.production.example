# FALCON production settings. Copy to deploy/.env.production (git-ignored) and fill in.
# FALCON refuses to start if any of these are unsafe (see backend/app/core/production.py).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

ENVIRONMENT=production

# The web address. With a real domain pointing to this server, Caddy gets a free
# Let's Encrypt certificate automatically. "localhost" = local test certificate.
FALCON_SITE=falcon.example.org

# Database (only reachable inside Docker). At least 16 characters.
POSTGRES_DB=falcon
POSTGRES_USER=falcon
POSTGRES_PASSWORD=

# Encrypts MFA secrets. At least 32 characters. Keep it: changing it disables everyone's MFA.
FALCON_SECRET_KEY=

# HTTPS only.
SESSION_COOKIE_SECURE=true

# Local AI: start with `--profile ai`, then once:
#   docker compose -f docker-compose.prod.yml --env-file deploy/.env.production \
#     exec ollama ollama pull qwen3:8b && ... ollama pull all-minilm
AI_ENABLED=true

# Optional: other ports (e.g. when testing next to the development setup)
# WEB_HTTP_PORT=8080
# WEB_HTTPS_PORT=8443
